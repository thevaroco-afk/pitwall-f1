// Configuração do Cloudflare Worker (site + /api/news + /api/openf1)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pitwall-f1",
  "main": "worker/index.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./htdocs",
    "binding": "ASSETS"
  },
  // Armazenamento das sessões OpenF1 já terminadas (Workers KV "pitwall-openf1")
  "kv_namespaces": [
    { "binding": "OF1_CACHE", "id": "38f2582f464742fa9b9c886294e2bb9a" }
  ],
  "observability": { "enabled": true }
}
